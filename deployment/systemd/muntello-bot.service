[Unit]
Description=Muntello Support Bot
After=network.target
Documentation=https://github.com/Muntello/muntello.me

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/muntello

# Environment
Environment="PATH=/opt/muntello/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/etc/muntello/.env

# Start command
ExecStart=/opt/muntello/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-config /dev/null

# Restart policy
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/muntello /var/log/muntello

# Limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
