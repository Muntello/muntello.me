# Muntello Support Bot - Caddy Configuration

support.muntello.me {
    # Reverse proxy to FastAPI application
    reverse_proxy localhost:8000 {
        # Health check
        health_uri /health
        health_interval 10s
        health_timeout 5s
        health_status 2xx
    }

    # Logging
    log {
        output file /var/log/caddy/support.log {
            roll_size 10mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
        level INFO
    }

    # Security headers
    header {
        # XSS Protection
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"

        # Remove server information
        -Server

        # HSTS (optional, uncomment for production)
        # Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Gzip compression
    encode gzip

    # Rate limiting (optional)
    # rate_limit {
    #     zone webhook {
    #         key {remote_host}
    #         events 100
    #         window 1m
    #     }
    # }
}
